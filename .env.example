# Optional OpenAI-compatible endpoint for Toolkit Tester or another dogfood harness.
# Carrie White is the Codespaces default. Copy this file to .env for a local shell.
# .env is gitignored. Leave the keys empty here.

OPENAI_BASE_URL=https://chat.srv1536099.hstgr.cloud/v1
OPENAI_API_KEY=
# Same token, if your harness already uses this name.
LLAMA_API_KEY=
# Confirm with GET $OPENAI_BASE_URL/models. This is the expected llama.cpp id.
OPENAI_MODEL=Llama-3.2-3B-Instruct
